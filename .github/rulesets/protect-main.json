{
  "name": "Proteggi main",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request" }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          { "context": "Web (tipi, test, build, audit)" },
          { "context": "Oracolo TS (le fixture golden coincidono con i motori)" },
          { "context": "Dipendenze Rust (advisory, licenze, fonti)" },
          { "context": "Rust (fmt, clippy, test, wasm)" },
          { "context": "Motore WebAssembly (ricompilato, parità con il TypeScript)" }
        ]
      }
    }
  ]
}
